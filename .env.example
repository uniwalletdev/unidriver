# ----------------------------------------------------------------------------
# UniDriver — environment template. Copy to apps/api/.env for local development.
# All real third-party integrations are STUBBED behind adapters in Phase 0, so
# the only values required to boot the API locally are DATABASE_URL + REDIS_URL.
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated allowed browser origins (e.g. your Vercel URL in production).
# Leave empty in dev to reflect any origin.
CORS_ORIGINS=

# --- Datastores (match docker-compose.yml) ---
DATABASE_URL=postgresql://unidriver:unidriver@localhost:5432/unidriver?schema=public
REDIS_URL=redis://localhost:6379

# --- Region runtime: US-only at MVP (data model is multi-region capable) ---
DEFAULT_REGION=US

# --- Auth ---
# AUTH_PROVIDER=mock  → dev bearer tokens `dev:<userId>:<ROLE>` (default)
# AUTH_PROVIDER=clerk → verify Clerk session JWTs; requires AUTH_JWT_ISSUER
AUTH_PROVIDER=mock
# Mock dev tokens grant any role, so the API refuses to boot with AUTH_PROVIDER=mock when
# NODE_ENV=production. Set ALLOW_MOCK_AUTH=true ONLY for a protected staging/pilot deploy.
ALLOW_MOCK_AUTH=
# Clerk: your Frontend API URL, e.g. https://your-instance.clerk.accounts.dev
# (Clerk Dashboard → Configure → API keys). JWKS defaults to <issuer>/.well-known/jwks.json.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=

# --- Web (apps/web — set these on Vercel, not here) ---
# NEXT_PUBLIC_API_URL=https://<railway-api-url>
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Adapter mode: set to "mock" in Phase 0. Real keys wired in later phases. ---
ADAPTER_MODE=mock

# Stripe Connect (Payments & Payout) — Phase 4
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Checkr (Background checks) — Phase 2
CHECKR_API_KEY=

# Smartcar (Telematics) — Phase 5/6
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=

# Maps / geo — Mapbox or Google
MAPBOX_TOKEN=

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FCM_SERVER_KEY=

# Storage
AWS_S3_BUCKET=
AWS_REGION=us-east-1
